# Copy to .env and adjust as needed. All values here are the same as the
# built-in defaults; .env is optional for local development.

# Port published on the host for the API/SPA.
DASHCAM_ADDR_PORT=8080

# Paths inside the container (backed by the data/cache named volumes).
DASHCAM_DB=/data/dashcam.db
DASHCAM_CACHE=/cache

# Path inside the container where the recorder's SSD is mounted. If
# DASHCAM_SSD_UUID is set, internal/ssd mounts/unmounts it here itself on
# hotplug; otherwise it's expected to already be mounted by whatever put
# it there (legacy behaviour). See README's "USB SSD hotplug".
DASHCAM_SSD_PATH=/mnt/dashcam

# Filesystem UUID of the recorder's USB SSD (find with `lsblk -f`), e.g.
# F9B1-23CB. Empty disables the in-container hotplug watcher.
DASHCAM_SSD_UUID=

# Intel QSV render node for ffmpeg hardware acceleration. Only used with
# compose.intel.yaml layered in — see README's "Hardware acceleration".
DASHCAM_QSV_DEVICE=/dev/dri/renderD128

# GID of the host's "render" group, so the container user can access
# /dev/dri. Find it with: getent group render. Only used with
# compose.intel.yaml layered in.
RENDER_GID=110

# CUDA device index for NVIDIA NVENC/NVDEC ffmpeg hardware acceleration.
# Only used with compose.nvidia.yaml layered in — see README's "Hardware
# acceleration".
DASHCAM_CUDA_DEVICE=0

# Optional. Encrypts stored SMB/CIFS share credentials and the OIDC client
# secret. Leave empty: a key is generated on first start and kept in
# secret.key next to the database. Set it on an existing install to keep
# already-encrypted credentials readable. Generate with: openssl rand -base64 32
DASHCAM_SECRET_KEY=

# Every variable below except DASHCAM_DB / DASHCAM_CACHE / DASHCAM_ADDR only
# seeds the setting on first start; once saved, the Settings page wins.

# Recovery only: 1 bypasses sign-in for every request even if OIDC is on.
#DASHCAM_AUTH_DISABLE=1

# Background job worker concurrency.
DASHCAM_WORKERS=4

# Optional OIDC login seed. Leave DASHCAM_OIDC_ISSUER / DASHCAM_OIDC_CLIENT_ID
# empty for no authentication (LAN-trusted) and enable it later in Settings,
# which tests the login before saving. See README's "Security" section.
# Externally visible base URL (no trailing slash).
# The IdP redirect URI is <this>/auth/callback.
#DASHCAM_PUBLIC_URL=https://dashcam.example.com
#DASHCAM_OIDC_ISSUER=https://idp.example.com/realms/home
#DASHCAM_OIDC_CLIENT_ID=dashcam
# Empty = public client (PKCE only).
#DASHCAM_OIDC_CLIENT_SECRET=
# Space or comma separated. Default: openid email profile
#DASHCAM_OIDC_SCOPES=openid email profile
# Restrict sign-in; with both empty any user the IdP authenticates is allowed.
#DASHCAM_OIDC_ALLOWED_EMAILS=you@example.com,partner@example.com
#DASHCAM_OIDC_ALLOWED_GROUPS=family
# ID token claim holding groups. Default: groups
#DASHCAM_OIDC_GROUPS_CLAIM=groups

# Before first `docker compose up`, the ./shares bind-mount source needs
# rshared propagation so that CIFS mounts made inside the container (M9) are
# visible on the host and vice versa. One-time host setup:
#   sudo mount --bind ./shares ./shares
#   sudo mount --make-rshared ./shares
# (This must be redone after every host reboot unless added to /etc/fstab —
# see README.)
