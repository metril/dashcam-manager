# Frontend
node_modules/

# Built SPA embedded by the Go binary — regenerated by `npm run build`.
cmd/api/dist/*
!cmd/api/dist/.gitkeep

# Local state
.superpowers/
*.db
*.db-shm
*.db-wal
.env

# Go
/dashcam-api

# Shares bind-mount source dir (host CIFS mounts land here at runtime)
/shares/*
!/shares/.gitkeep
/api
.playwright-mcp/

# Stray outputs from fake-ffmpeg test stubs (probe args used as filenames)
cmd/api/-*

# Go build cache left by containerised/agent builds
/.gocache/
/.gomodcache/

# Local planning/reference docs (not published)
docs/superpowers/
docs/upstream/
